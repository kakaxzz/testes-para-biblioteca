generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Livro {
  id                      Int        @id @default(autoincrement())
  titulo                  String
  autor                   String
  isbn                    String     @unique
  sinopse                 String?
  capa                    String?
  assuntos                String?
  editora                 String?
  edicao                  String?
  volume                  String?
  cdd                     String?
  cutter                  String?
  criadoEm                DateTime   @default(now())
  // "L", "10", "12", "14", "16" ou "18". null = não informada
  classificacaoIndicativa String?
  exemplares              Exemplar[]
}

model Exemplar {
  id          Int          @id @default(autoincrement())
  livroId     Int
  tombo       Int          @unique
  status      String       @default("disponivel")
  criadoEm    DateTime     @default(now())
  emprestimos Emprestimo[]
  livro       Livro        @relation(fields: [livroId], references: [id])
}

model Usuario {
  id          Int          @id @default(autoincrement())
  nome        String
  matricula   String?      @unique
  whatsapp    String
  tipo        TipoUsuario
  cpf         String?      @unique
  criadoEm    DateTime     @default(now())
  turma       String?
  emprestimos Emprestimo[]
}

model Emprestimo {
  id                     Int       @id @default(autoincrement())
  usuarioId              Int
  exemplarId             Int
  dataEmprestimo         DateTime  @default(now())
  dataDevolucao          DateTime?
  autorizacaoResponsavel Boolean   @default(false)
  exemplar               Exemplar  @relation(fields: [exemplarId], references: [id])
  usuario                Usuario   @relation(fields: [usuarioId], references: [id])
}

model Admin {
  id    Int    @id @default(autoincrement())
  email String @unique
  senha String
}

// O PDF fica na própria linha do TCC (arquivoDados)
model Tcc {
  id           Int         @id @default(autoincrement())
  titulo       String
  autor        String
  ano          Int
  tipo         String      @default("tcc")
  resumo       String?
  criadoEm     DateTime    @default(now())
  arquivoDados Bytes
  arquivoNome  String
  arquivoTipo  String      @default("application/pdf")
  arquivoPdf   TccArquivo?
}

// Já existe no banco; não é usada pelo código atual
model TccArquivo {
  id    Int   @id @default(autoincrement())
  tccId Int   @unique
  dados Bytes
  tcc   Tcc   @relation(fields: [tccId], references: [id], onDelete: Cascade)
}

model Aviso {
  id       Int          @id @default(autoincrement())
  titulo   String
  mensagem String
  tag      String
  ordem    Int          @default(0)
  criadoEm DateTime     @default(now())
  // Data mostrada no aviso (se vazia, usa a data de criação)
  data     DateTime?
  imagem   AvisoImagem?
}

// Imagem do aviso fica em tabela própria (o disco da Vercel é somente leitura
// e assim a listagem de avisos nunca carrega os bytes da imagem)
model AvisoImagem {
  id           Int      @id @default(autoincrement())
  avisoId      Int      @unique
  tipo         String
  dados        Bytes
  atualizadoEm DateTime @default(now()) @updatedAt
  aviso        Aviso    @relation(fields: [avisoId], references: [id], onDelete: Cascade)
}

model AccessToken {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum TipoUsuario {
  ALUNO
  FUNCIONARIO
  RESPONSAVEL
}

// Uma linha por virada de ano já feita (impede rodar duas vezes) + o resumo
// das estatísticas daquele ano, guardado antes de apagar os alunos que saíram
model Virada {
  ano          Int      @id
  executadoEm  DateTime @default(now())
  promovidos   Int      @default(0)
  removidos    Int      @default(0)
  pendentes    Int      @default(0)
  estatisticas Json
}
