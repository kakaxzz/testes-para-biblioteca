diff --git a/app/api/admin/change-username/route.ts b/app/api/admin/change-username/route.ts
new file mode 100644
index 0000000..327816a
--- /dev/null
+++ b/app/api/admin/change-username/route.ts
@@ -0,0 +1,102 @@
+import { NextRequest, NextResponse } from "next/server";
+import { cookies } from "next/headers";
+import { prisma } from "@/lib/prisma";
+import {
+  SESSION_COOKIE,
+  SESSION_DURATION_SECONDS,
+  verifySessionToken,
+  verifyPassword,
+  createSessionToken,
+} from "@/lib/auth";
+
+export async function POST(request: NextRequest) {
+  try {
+    const cookieStore = await cookies();
+    const token = cookieStore.get(SESSION_COOKIE)?.value;
+
+    if (!token) {
+      return NextResponse.json({ error: "Não autorizado" }, { status: 401 });
+    }
+
+    const payload = await verifySessionToken(token);
+    if (!payload) {
+      return NextResponse.json({ error: "Sessão inválida ou expirada" }, { status: 401 });
+    }
+
+    const { currentPassword, newUsername } = await request.json();
+
+    if (typeof currentPassword !== "string" || typeof newUsername !== "string") {
+      return NextResponse.json(
+        { error: "Preencha o novo usuário e a senha atual" },
+        { status: 400 }
+      );
+    }
+
+    const novoUsuario = newUsername.trim();
+
+    if (novoUsuario.length < 3) {
+      return NextResponse.json(
+        { error: "O novo usuário precisa ter pelo menos 3 caracteres" },
+        { status: 400 }
+      );
+    }
+
+    if (/\s/.test(novoUsuario)) {
+      return NextResponse.json(
+        { error: "O usuário não pode ter espaços" },
+        { status: 400 }
+      );
+    }
+
+    if (novoUsuario === payload.usuario) {
+      return NextResponse.json(
+        { error: "O novo usuário precisa ser diferente do atual" },
+        { status: 400 }
+      );
+    }
+
+    const admin = await prisma.admin.findUnique({
+      where: { email: payload.usuario },
+    });
+
+    if (!admin) {
+      return NextResponse.json({ error: "Admin não encontrado" }, { status: 404 });
+    }
+
+    const senhaValida = await verifyPassword(currentPassword, admin.senha);
+    if (!senhaValida) {
+      return NextResponse.json({ error: "Senha atual incorreta" }, { status: 401 });
+    }
+
+    const jaExiste = await prisma.admin.findUnique({
+      where: { email: novoUsuario },
+    });
+    if (jaExiste) {
+      return NextResponse.json({ error: "Esse usuário já está em uso" }, { status: 409 });
+    }
+
+    await prisma.admin.update({
+      where: { id: admin.id },
+      data: { email: novoUsuario },
+    });
+
+    // O JWT guarda o usuário antigo; emite um novo para a sessão continuar válida.
+    const novoToken = await createSessionToken(novoUsuario);
+    const response = NextResponse.json({
+      success: true,
+      message: "Usuário alterado com sucesso",
+      usuario: novoUsuario,
+    });
+    response.cookies.set(SESSION_COOKIE, novoToken, {
+      httpOnly: true,
+      secure: process.env.NODE_ENV === "production",
+      sameSite: "lax",
+      path: "/",
+      maxAge: SESSION_DURATION_SECONDS,
+    });
+    return response;
+  } catch (error) {
+    console.error("Erro ao trocar usuário:", error);
+    return NextResponse.json({ error: "Erro interno ao trocar o usuário" }, { status: 500 });
+  }
+}
diff --git a/components/admin/TrocarUsuarioForm.tsx b/components/admin/TrocarUsuarioForm.tsx
new file mode 100644
index 0000000..d0e4980
--- /dev/null
+++ b/components/admin/TrocarUsuarioForm.tsx
@@ -0,0 +1,76 @@
+"use client"
+
+import { useState } from "react"
+import { PasswordInput } from "@/components/PasswordInput"
+
+const VAZIO = { novo: "", senha: "" }
+
+export function TrocarUsuarioForm() {
+  const [form, setForm] = useState(VAZIO)
+  const [loading, setLoading] = useState(false)
+  const [msg, setMsg] = useState<{ ok: boolean; texto: string } | null>(null)
+
+  async function enviar(e: React.FormEvent) {
+    e.preventDefault()
+    setMsg(null)
+    setLoading(true)
+    try {
+      const res = await fetch("/api/admin/change-username", {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({ newUsername: form.novo, currentPassword: form.senha }),
+      })
+      const data = await res.json()
+      if (res.ok) {
+        setMsg({ ok: true, texto: data.message || "Usuário alterado com sucesso" })
+        setForm(VAZIO)
+      } else {
+        setMsg({ ok: false, texto: data.error || "Erro ao trocar usuário" })
+      }
+    } catch {
+      setMsg({ ok: false, texto: "Erro de conexão. Tenta de novo." })
+    } finally {
+      setLoading(false)
+    }
+  }
+
+  return (
+    <section className="card">
+      <h2 className="section-title">Trocar usuário</h2>
+      <p className="-mt-2 mb-5 text-sm text-[#7b5d5d]">Atualize o usuário usado para entrar no painel administrativo.</p>
+
+      <form onSubmit={enviar}>
+        <div className="input-group">
+          <label htmlFor="usuario-novo">Novo usuário</label>
+          <input
+            id="usuario-novo"
+            type="text"
+            className="input-field"
+            value={form.novo}
+            onChange={(e) => setForm((f) => ({ ...f, novo: e.target.value }))}
+            autoComplete="username"
+            minLength={3}
+            required
+          />
+        </div>
+
+        <div className="input-group">
+          <label htmlFor="usuario-senha">Senha atual</label>
+          <PasswordInput
+            id="usuario-senha"
+            value={form.senha}
+            onChange={(e) => setForm((f) => ({ ...f, senha: e.target.value }))}
+            autoComplete="current-password"
+            required
+          />
+        </div>
+
+        {msg && <div className={msg.ok ? "mensagem-ok" : "mensagem-erro"}>{msg.texto}</div>}
+
+        <button type="submit" className="btn-primary mt-5 w-full sm:w-auto" disabled={loading}>
+          {loading ? "Salvando..." : "Trocar usuário"}
+        </button>
+      </form>
+    </section>
+  )
+}
